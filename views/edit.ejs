<script>
  document.addEventListener('DOMContentLoaded', function() {
      // รายการมหาวิทยาลัย
      const universities = [
          "จุฬาลงกรณ์มหาวิทยาลัย",
          "มหาวิทยาลัยธรรมศาสตร์",
          "มหาวิทยาลัยมหิดล",
          "มหาวิทยาลัยเกษตรศาสตร์",
          "มหาวิทยาลัยเชียงใหม่",
          "มหาวิทยาลัยขอนแก่น",
          "มหาวิทยาลัยศิลปากร",
          "มหาวิทยาลัยเทคโนโลยีพระจอมเกล้าธนบุรี",
          "มหาวิทยาลัยเทคโนโลยีพระจอมเกล้าพระนครเหนือ",
          "มหาวิทยาลัยเทคโนโลยีพระจอมเกล้าลาดกระบัง",
          "มหาวิทยาลัยกรุงเทพ",
          "มหาวิทยาลัยรังสิต",
          "มหาวิทยาลัยนเรศวร",
          "มหาวิทยาลัยแม่ฟ้าหลวง",
          "มหาวิทยาลัยวลัยลักษณ์",
          "มหาวิทยาลัยเทคโนโลยีสุรนารี",
          "มหาวิทยาลัยบูรพา",
          "มหาวิทยาลัยสงขลานครินทร์",
          "มหาวิทยาลัยศรีนครินทรวิโรฒ",
          "มหาวิทยาลัยเทคโนโลยีราชมงคลธัญบุรี",
          "มหาวิทยาลัยรามคำแหง",
          "มหาวิทยาลัยอัสสัมชัญ"
          // เพิ่มมหาวิทยาลัยอื่นๆ ตามต้องการ
      ];
      
      // รายการคณะ
      const faculties = [
          "วิศวกรรมศาสตร์",
          "แพทยศาสตร์",
          "นิติศาสตร์",
          "บริหารธุรกิจ",
          "เศรษฐศาสตร์",
          "อักษรศาสตร์",
          "วิทยาศาสตร์",
          "ครุศาสตร์",
          "เภสัชศาสตร์",
          "พยาบาล",
          "วิทยาศาสตร์คอมพิวเตอร์",
          "บริหารธุรกิจ",
          "เศรษฐศาสตร์",
          "ทันตแพทยศาสตร์",
          "สถาปัตยกรรมศาสตร์",
          "สาธารณสุขศาสตร์",
          "การบัญชี",
          "รัฐศาสตร์",
          "นิเทศศาสตร์",
          "วิทยาศาสตร์การกีฬา",
          "การท่องเที่ยวและการโรงแรม",
          "การตลาด"
          // เพิ่มคณะอื่นๆ ตามต้องการ
      ];

      function setupAutocomplete(inputId, suggestionsList, suggestions) {
          const input = document.getElementById(inputId);
          const autocompleteList = document.getElementById(suggestionsList);
          
          input.addEventListener('input', function() {
              const value = this.value.toLowerCase();
              autocompleteList.innerHTML = '';
              
              if (!value) {
                  autocompleteList.style.display = 'none';
                  return;
              }
              
              const filteredSuggestions = suggestions.filter(item => 
                  item.toLowerCase().includes(value)
              );
              
              if (filteredSuggestions.length === 0) {
                  autocompleteList.style.display = 'none';
                  return;
              }
              
              filteredSuggestions.forEach(suggestion => {
                  const suggestionDiv = document.createElement('div');
                  suggestionDiv.className = 'autocomplete-suggestion';
                  suggestionDiv.textContent = suggestion;
                  suggestionDiv.addEventListener('click', function() {
                      input.value = suggestion;
                      autocompleteList.innerHTML = '';
                      autocompleteList.style.display = 'none';
                  });
                  autocompleteList.appendChild(suggestionDiv);
              });
              
              autocompleteList.style.display = 'block';
          });
          
          document.addEventListener('click', function(e) {
              if (e.target !== input) {
                  autocompleteList.innerHTML = '';
                  autocompleteList.style.display = 'none';
              }
          });
      }

      // เรียกใช้ฟังก์ชันสำหรับมหาวิทยาลัยและคณะ
      setupAutocomplete('university-search', 'autocomplete-list-university', universities);
      setupAutocomplete('faculty-search', 'autocomplete-list-faculty', faculties);
  });
</script>
    <script src="js/drop.js"></script>
    <script src="js/Profile"></script>
</html>